{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Emerald",
  "scopeName": "source.emerald",
  "fileTypes": ["eml", "emr", "elr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtinFunctions" },
    { "include": "#subcommand" },
    { "include": "#functionDef" },
    { "include": "#entryPoint" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.emerald",
          "match": "//.*$"
        },
        {
          "name": "comment.block.emerald",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.emerald",
          "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.emerald" },
            "2": { "name": "entity.name.namespace.emerald" },
            "3": { "name": "punctuation.terminator.emerald" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.emerald",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.emerald",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.emerald",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.emerald",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.emerald",
          "match": "\\b(return|if|else|while|for|break|continue|newline|input)\\b"
        },
        {
          "name": "storage.type.function.emerald",
          "match": "\\bfunction\\b"
        },
        {
          "name": "keyword.other.list.emerald",
          "match": "\\blist\\b"
        },
        {
          "name": "keyword.other.format.emerald",
          "match": "\\bformat\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.emerald",
          "match": "\\b(int|string|bool)\\b"
        }
      ]
    },
    "builtinFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.emerald",
          "match": "\\b(print|speak|input|newline|format|list)\\b(?=\\s*\\()"
        }
      ]
    },
    "subcommand": {
      "patterns": [
        {
          "name": "meta.subcommand.emerald",
          "match": "\\b(subcommand)\\b",
          "captures": {
            "1": { "name": "keyword.other.subcommand.emerald" }
          }
        }
      ]
    },
    "functionDef": {
      "patterns": [
        {
          "name": "meta.function.emerald",
          "begin": "\\b(function|int|string|bool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "storage.type.emerald" },
            "2": { "name": "entity.name.function.emerald" },
            "3": { "name": "punctuation.definition.parameters.begin.emerald" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.emerald" }
          }
        }
      ]
    },
    "entryPoint": {
      "patterns": [
        {
          "name": "meta.function.entry.emerald",
          "match": "\\b(eml)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.entry.emerald" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.emerald",
          "match": "(==|!=|<=|>=|&&|\\|\\||[=+\\-*/<>!])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.emerald",
          "match": "[;,.]"
        },
        {
          "name": "punctuation.section.emerald",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}